# Local / Mac defaults. Never use the default password in production.
APP_ENV=development
POSTGRES_DB=ups_observatory
POSTGRES_USER=ups
POSTGRES_PASSWORD=ups-local-dev
POSTGRES_PORT=5432
WEB_PORT=3000
API_PORT=8000

# Three-layer analytical model
LAMBDA_IGMD=0.50
LAMBDA_IOC=0.30
LAMBDA_IKO=0.20
DIMENSION_WEIGHTS=0.20,0.20,0.20,0.20,0.20
OBJECTIVE_WEIGHTS=0.20,0.20,0.20,0.20,0.20

# Optional live Notion integration. Snapshot seed works without a token.
NOTION_API_TOKEN=
NOTION_ROOT_PAGE_ID=175b0841d99482f0a2a881a9c73be108

# Production only
APP_PORT=80
PUBLIC_ORIGIN=http://localhost
